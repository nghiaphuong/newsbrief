# ===== NewsBrief – biến môi trường =====
# Trên Hostinger: đặt các biến này trong phần Environment variables của ứng dụng Node.js.
# KHÔNG commit file .env thật lên GitHub (repo đang để public).

PORT=3000
TZ=Europe/Oslo
PUBLIC_URL=https://newsbrief.example.com

# MySQL (tạo trong hPanel > Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_newsbrief
DB_USER=u000000000_newsbrief
DB_PASSWORD=change-me

# Đăng nhập trang web (trang có lưu toàn văn bài báo nên phải để riêng tư)
APP_PASSWORD=change-me
SESSION_SECRET=một-chuỗi-ngẫu-nhiên-dài-ít-nhất-32-ký-tự

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model rẻ hơn dùng cho bước chấm điểm mức độ liên quan (có thể để trùng model trên)
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Chế độ "Miễn phí, không dùng AI" (Cài đặt → Chế độ xử lý tin): Google Cloud Translation – Basic (v2).
# Tạo API key trong Google Cloud Console. Google miễn phí 500.000 ký tự/tháng; app tự dừng dịch ở mức này
# (tính theo tháng giờ Thái Bình Dương như Google). Có thể đặt giới hạn thấp hơn, không thể đặt cao hơn 500000.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_MONTHLY_LIMIT=500000

# Chế độ "Gói Claude Team/Pro" (mặc định): KHÔNG bắt buộc. Nếu để trống, server tự tạo token và lưu trong CSDL;
# lấy lệnh cài cho máy chạy Claude ở Cài đặt → Chế độ xử lý tin (xem docs/CLAUDE_PLAN.md).
AGENT_API_TOKEN=

# Email báo cáo tuần (Gmail: bật 2FA rồi tạo App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NewsBrief <your.account@gmail.com>"
WEEKLY_TO=tratran.norway@gmail.com

# Khóa để Cron job của Hostinger gọi /api/cron/* (dự phòng khi tiến trình Node ngủ)
CRON_KEY=một-chuỗi-ngẫu-nhiên-khác

# Token cho API chỉ-đọc /api/v1/* (để Claude hoặc công cụ khác truy cập dữ liệu sau này)
READONLY_API_TOKEN=một-chuỗi-ngẫu-nhiên-nữa
